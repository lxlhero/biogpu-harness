{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "precision_config.schema.json",
  "title": "BioGPU Precision Config (from test_plan markdown YAML block)",
  "type": "object",
  "required": ["precision_config"],
  "properties": {
    "precision_config": {
      "type": "object",
      "required": ["test_suite", "metrics"],
      "properties": {
        "test_suite": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "pearson", "spearman", "rmse", "mae", "max_abs_error",
                  "relative_error", "jaccard", "f1", "exact_match",
                  "row_count_match", "file_exists", "ratio"
                ]
              },
              "cpu_file":       { "type": ["string", "null"] },
              "gpu_file":       { "type": ["string", "null"] },
              "key_column":     { "type": ["string", "null"] },
              "value_column":   { "type": ["string", "null"] },
              "label_column":   { "type": ["string", "null"] },
              "threshold":      { "type": ["number", "null"] },
              "threshold_low":  { "type": ["number", "null"] },
              "threshold_high": { "type": ["number", "null"] },
              "direction":      { "type": ["string", "null"], "enum": [">=", "<=", ">", "<", "==", null] },
              "file":           { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
